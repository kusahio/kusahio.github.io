---
import { Icon } from "astro-icon/components";
import sqlalchemyIcon from "@/assets/icons/sqlalchemy.svg";
import fastapiIcon from "@/assets/icons/fastapi.svg";
import jwtIcon from "@/assets/icons/jwt-logo.svg";
import codeAiIcon from "@/assets/icons/code-ai.svg";
import n8nIcon from "@/assets/icons/n8n.svg";

const ICON_MAP: Record<string, string | ImageMetadata> = {
  react: "tabler:brand-react",
  nextjs: "tabler:brand-nextjs",
  typescript: "tabler:brand-typescript",
  python: "tabler:brand-python",
  docker: "tabler:brand-docker",
  figma: "tabler:brand-figma",
  git: "tabler:brand-git",
  github: "tabler:brand-github",
  wordpress: "tabler:brand-wordpress",
  postgresql: "tabler:database",
  fastapi: fastapiIcon,
  linkedin: "tabler:brand-linkedin",
  externalLink: "tabler:external-link",
  email: "tabler:mail",
  copyright: "tabler:copyright",
  menubar: "tabler:menu-2",
  sqlalchemy: sqlalchemyIcon,
  jwt: jwtIcon,
  ai: codeAiIcon,
  n8n: n8nIcon,
};

type IconName = keyof typeof ICON_MAP;

interface Props {
  icon: IconName;
  stroke?: number;
  sizeClass?: string;
}

const {
  icon,
  stroke = 1.7,
  sizeClass = "w-7 h-7 md:w-10 md:h-10",
} = Astro.props;

const iconData = ICON_MAP[icon];
const isTablerIcon = typeof iconData === "string";
---

{iconData ? (
  isTablerIcon ? (
    <Icon
      name={iconData}
      class={`text-current transition-colors duration-300 ${sizeClass}`}
      stroke-width={stroke}
    />
  ) : (
    <img
      src={iconData.src}
      alt={icon}
      class={`text-current transition-colors duration-300 ${sizeClass}`}
    />
  )
) : (
  <Icon
    name="tabler:code"
    class={`text-current transition-colors duration-300 ${sizeClass}`}
    stroke-width={stroke}
  />
)}
