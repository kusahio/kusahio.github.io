---
import type { CVData } from "@/data/cv";
import Link from "@/components/ui/Link.astro";
import CopyLink from "@/components/ui/CopyLink.astro";

interface Props {
  contact: CVData['contact'];
}

const { contact } = Astro.props;
---

<section id="hablemos" class="w-full flex justify-center px-6 md:px-12 lg:px-24 py-24 overflow-hidden bg-brand-red">
  <div class="w-full max-w-7xl flex flex-col gap-8">
    <h2 class="font-display text-4xl md:text-5xl uppercase text-white">
      {contact.title}
    </h2>
    <p class="text-white text-base max-w-lg font-semibold">
      {contact.description}
    </p>
    {contact.contactLinks && contact.contactLinks.length > 0 &&(
      <div class="flex flex-row flex-wrap gap-4 items-center">
        {contact.contactLinks.map(item => {
          if (item.title === 'Email') {
            return (
              <Fragment key={item.title}>
                <div class="md:hidden">
                  <Link
                    href={`mailto:${item.link}`}
                    label={item.title}
                    icon={item.icon}
                    type="contact"
                  />
                </div>

                <div class="hidden md:block">
                  <CopyLink
                    value={item.link} 
                    label={item.title} 
                    icon={item.icon}
                    toastMessage={contact.copyToast}
                  />
                </div>
              </Fragment>
            )
          }
          return (
            <Fragment key={item.title}>
              <Link
                href={item.link}
                icon={item.icon}
                type='contact'
                label={item.title}
              />
            </Fragment>
          )
        })}
      </div>
    )}
  </div>
</section>
