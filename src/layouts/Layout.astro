---
import "@/styles/global.css";
import '@fontsource/archivo-black/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import Navbar from "@/components/Navbar.astro";
import { CV } from "@/data/cv";

interface Props {
  title: string;
  description: string;
  permaLink: string;
}

const { title, description, permaLink } = Astro.props;

const ogImageLarge = new URL('/og-image.jpg', Astro.site);
const ogImageSquare = new URL('/og-image-square.jpg', Astro.site);
const favicon = new URL('/favicon.svg', Astro.site);
const link = new URL(permaLink, Astro.site);

const navItems = [
  { label: "Sobre mí", href: "#about" },
  { label: "Experiencia", href: "#experience" },
  { label: "Proyectos", href: "#projects" },
  { label: "Hablemos", href: "#hablemos" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={link} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta property="og:image" content={ogImageLarge} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <meta property="og:image" content={ogImageSquare} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="twitter:image" content={ogImageLarge} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={link} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageLarge} />
  </head>
  <body
    class="bg-brand-bg text-brand-black font-body selection:bg-brand-yellow"
  >
    <Navbar header={CV.header} navItems={navItems} />
    <slot />
  </body>
</html>
